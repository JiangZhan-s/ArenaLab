    {
      "name": "stale-generation-cannot-settle",
      "steps": [
        {
          "op": "reset",
          "args": {
            "profile": "dedicated",
            "seed": "ready"
          },
          "want": {
            "isolated": true,
            "state": "ready"
          }
        },
        {
          "op": "allocate",
          "args": {
            "request_id": "alloc1",
            "build": "ds-v1",
            "region": "local"
          },
          "want": {
            "generation": 1
          }
        },
        {
          "op": "process",
          "args": {
            "action": "kill_ds"
          },
          "want": {
            "killed": true
          }
        },
        {
          "op": "await",
          "args": {
            "condition": "allocation_aborted",
            "timeout_ms": 5000
          },
          "want": {
            "state": "aborted"
          }
        },
        {
          "op": "ds_result",
          "args": {
            "identity": "old_ds",
            "generation": 1,
            "winner": 0
          },
          "want": {
            "error": "stale_allocation"
          }
        },
        {
          "op": "observe",
          "args": {
            "source": "sql"
          },
          "want": {
            "ledger_rows": 0
          }
        }
      ]
